# ==========================================
# CONFIGURACIÓN DE ENTORNO (EJEMPLO)
# ==========================================
# Copia este archivo a .env.development, .env.staging o .env.production
# y completa los valores reales para cada entorno.

# --- BASE DE DATOS ---
# URL de conexión a la base de datos PostgreSQL (ej. Neon o Railway)
DATABASE_URL="postgresql://usuario:password@host:5432/basededatos?sslmode=require"

# --- GOOGLE OAUTH ---
# Credenciales de Google Cloud Console para Login
GOOGLE_CLIENT_ID="tu-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="tu-client-secret"

# --- FRONTEND ---
# URL pública del frontend (usada para redirecciones de OAuth y CORS)
FRONTEND_URL="http://localhost:3000"

# --- MERCADO PAGO ---
# Token de acceso de MercadoPago (usa el token de prueba para staging/dev)
MP_ACCESS_TOKEN="TEST-dummy-token"

# --- SEGURIDAD ---
# Clave secreta para firmar los JSON Web Tokens (JWT)
JWT_SECRET_KEY="generar-clave-segura-aqui"
# Clave secreta para manejar las sesiones de usuario (SessionMiddleware)
SECRET_KEY="generar-clave-segura-aqui"

# --- AUDITORÍA (OPCIONAL) ---
# Habilita el log detallado de requests y performance (solo útil en staging)
AUDIT_MODE="false"
